{
  "name": "json-completer-nextjs-integration",
  "version": "1.0.0",
  "description": "Next.js integration tests for json_completer Rust binary",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "jest": "^29.5.0",
    "node-mocks-http": "^1.13.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@shared/(.*)$": "<rootDir>/../shared/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
